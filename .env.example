# Server Configuration
NODE_ENV=production
PORT=3000

# Email Configuration (SMTP)
# For Gmail: Use App Password (https://support.google.com/accounts/answer/185833)
# For other providers: Check their SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Contact Email (where form submissions are sent)
CONTACT_EMAIL=info@aintly.com

# CORS Configuration (comma-separated allowed origins)
# For production, specify your domain(s)
# Example: https://aintly.com,https://www.aintly.com
ALLOWED_ORIGINS=*

# Security
# Set to 'true' in production to use secure cookies
SECURE_COOKIES=false
